{
  "name": "eslint-plugin-kuzzle",
  "version": "1.0.0",
  "description": "Kuzzle Coding Standard",
  "homepage": "https://github.com/kuzzleio/eslint-plugin-kuzzle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuzzleio/eslint-plugin-kuzzle.git",
    "directory": "packages/backend"
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "kuzzle"
  ],
