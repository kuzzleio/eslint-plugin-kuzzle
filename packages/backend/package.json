      "optional": true
    }
  },
  "dependencies": {
    "@eslint/js": "^9.16.0 || ^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "typescript-eslint": "^8.51.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@typescript-eslint/utils": "^8.51.0",
    "rimraf": "^6.0.1",
    "typescript": "~5.9.0",
    "vitest": "^3.2.4"
  },
  "license": "Apache-2.0",
  "files": [
    "dist/",
    "README.md",
