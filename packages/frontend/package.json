{
  "name": "eslint-plugin-vue-kuzzle",
  "version": "1.0.0",
  "description": "Kuzzle Vue Coding Standard",
  "homepage": "https://github.com/kuzzleio/eslint-plugin-kuzzle",
  "repository": {
    "type": "git",
    "url": "https://github.com/kuzzleio/eslint-plugin-kuzzle.git",
    "directory": "packages/frontend"
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "vue",
    "kuzzle"
  ],
  "author": "The Kuzzle Team",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint",
    "clean": "rimraf dist",
    "build": "npm run clean && tsc --build"
  },
  "peerDependencies": {
    "eslint": "^9.10.0 || ^10.0.0",
    "typescript": ">= 5.2.0 <6.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.51.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@typescript-eslint/utils": "^8.51.0",
    "rimraf": "^6.0.1",
    "typescript": "~5.9.0"
  },
  "license": "Apache-2.0",
  "files": [
    "dist/",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./importOptions": "./dist/utils/importOptions.js"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
